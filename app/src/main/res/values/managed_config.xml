<resources>
    <string name="mc_enabled">Workloads enabled</string>
    <string name="mc_enabled_desc">Kill switch. Off stops any running workload and refuses new ones from UEM, adb and the display.</string>
    <string name="mc_local">Allow Go/Stop on the device</string>
    <string name="mc_local_desc">Off makes the display read-only; runs then come only from UEM or adb.</string>
    <string name="mc_title">Lab title shown on the display</string>
    <string name="mc_battery">Minimum battery while unplugged (%)</string>
    <string name="mc_battery_desc">Runs stop early below this level when the device is not charging.</string>
    <string name="mc_command">Command</string>
    <string name="mc_command_id">Command ID</string>
    <string name="mc_command_id_desc">Change to any new value (for example a timestamp) to execute the command once.</string>
    <string name="mc_profile">Profile</string>
    <string name="mc_profile_desc">Legacy MatrixRain Node presets (600 s, no baseline). Other keys override the preset.</string>
    <string name="mc_mode">Mode</string>
    <string name="mc_sites">Workday sites</string>
    <string name="mc_sites_desc">HTTPS URLs, one per line or comma-separated (1-64). Empty uses the built-in list.</string>
    <string name="mc_apps">Workday apps</string>
    <string name="mc_apps_desc">Package names to rotate, comma-separated (up to 32). Empty uses installed apps from the built-in list.</string>
    <string name="mc_download">Network: bulk download URL</string>
    <string name="mc_download_desc">HTTPS file you own or are allowed to load-test. Empty means latency probes only.</string>
    <string name="mc_fault">Fault (for command=Fault)</string>
    <string name="mc_fault_desc">Raised once per commandId in Matrix Rain itself; at most six per hour. Synthetic: tag the device so these are filtered in reports.</string>
